generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────── ENUMS ───────────────

enum BusinessType {
  provision_store
  supermarket
  pharmacy
  spare_parts
  hardware
  boutique
  wholesale
  cosmetics
  electronics
  stationery
  phone_accessories
  other
}

enum RecordingMode {
  daily_summary
  transaction
}

enum Tier {
  tier1
  tier2
}

enum UserRole {
  owner
  manager
  cashier
  stock_manager
}

enum EntryType {
  sale
  stock_purchase
  expense
  debtor_payment
  creditor_payment
  daily_summary
  opening_balance
  owner_deposit
  owner_withdrawal
  stock_count_adjustment
}

enum VerificationPurpose {
  email_verification
  password_reset
  email_change
}

enum PaymentMethod {
  cash
  mtn_momo
  telecel
  airtel
  bank
  credit
  mixed
}

enum ExpenseCategory {
  rent
  wages
  utilities
  transport
  momo_charges
  bank_charges
  packaging
  miscellaneous
}

enum AccountType {
  asset
  liability
  equity
  revenue
  cogs
  expense
}

enum NormalBalance {
  debit
  credit
}

enum DebtStatus {
  outstanding
  partial
  paid
}

enum StockCountType {
  actual
  estimated
  system
}

enum ConfidenceLevel {
  high
  medium
  low
}

enum AssetType {
  equipment
  furniture
  vehicle
  other
}

enum AssetCondition {
  good
  fair
  poor
}

enum SyncStatus {
  pending
  synced
  failed
  conflict
}

enum NotificationType {
  low_stock
  debt_overdue
  stock_count_due
  creditor_due
  monthly_summary_ready
}

enum TransactionSource {
  pos
  daily_form
  manual
  system
  import
}

// ─────────────── 1. businesses ───────────────

model Business {
  id                 String        @id @default(uuid())
  name               String
  type               BusinessType
  ownerName          String
  phoneNumber        String
  locationRegion     String
  locationDistrict   String
  recordingMode      RecordingMode
  tier               Tier
  staffInvites       StaffInvite[]
  currency           String        @default("GHS")
  isActive           Boolean       @default(true)
  onboardingComplete Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  users              User[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  journalLines       JournalLine[]
  sales              Sale[]
  expenses           Expense[]
  debtors            Debtor[]
  debts              Debt[]
  debtorPayments     DebtorPayment[]
  creditors          Creditor[]
  payables           Payable[]
  creditorPayments   CreditorPayment[]
  products           Product[]
  productCategories  ProductCategory[]
  saleItems          SaleItem[]
  stockPurchaseItems StockPurchaseItem[]
  stockCounts        StockCount[]
  assets             Asset[]
  syncQueue          SyncQueue[]
  notifications      Notification[]
  conversations Conversation[]

  @@map("businesses")
}

// ─────────────── 2. users ───────────────

model User {
  id           String    @id @default(uuid())
  businessId   String
  fullName     String
  email        String    @unique
  phoneNumber  String?
  passwordHash String
  role         UserRole
  roleTitle    String?
  pendingEmail String?
  emailVerified Boolean @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business           Business          @relation(fields: [businessId], references: [id])
  invitesSent        StaffInvite[]     @relation("InvitesSent")
  emailVerifications EmailVerification[]
  createdEntries     JournalEntry[]    @relation("CreatedBy")
  debtorPayments     DebtorPayment[]
  expenses           Expense[]
  creditorPayments   CreditorPayment[]
  products           Product[]
  stockCounts        StockCount[]
  syncQueue          SyncQueue[]
  refreshTokens      RefreshToken[]
  sales              Sale[]
  conversations      Conversation[]
  auditLogs          AuditLog[]

  @@index([businessId])
  @@map("users")
}

model EmailVerification {
  id         String              @id @default(uuid())
  userId     String
  purpose    VerificationPurpose @default(email_verification)
  codeHash   String
  expiresAt  DateTime
  attempts   Int                 @default(0)
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

// ─────────────── 3. accounts ───────────────

model Account {
  id            String        @id @default(uuid())
  businessId    String
  code          String
  name          String
  type          AccountType
  subtype       String
  normalBalance NormalBalance
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business     Business      @relation(fields: [businessId], references: [id])
  journalLines JournalLine[]
  expenses     Expense[]

  @@unique([businessId, code])
  @@unique([businessId, subtype])
  @@index([businessId])
  @@map("accounts")
}

model StaffInvite {
  id          String     @id @default(uuid())
  businessId  String
  email       String
  role        UserRole
  roleTitle   String?
  codeHash    String
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())

  business  Business @relation(fields: [businessId], references: [id])
  invitedBy User     @relation("InvitesSent", fields: [invitedById], references: [id])

  @@index([businessId])
  @@index([email])
  @@map("staff_invites")
}

// ─────────────── 4. journal_entries ───────────────

model JournalEntry {
  id              String            @id @default(uuid())
  businessId      String
  entryDate       DateTime          @db.Date
  description     String
  entryType       EntryType
  referenceNumber String
  source          TransactionSource
  paymentMethod   PaymentMethod?
  isVoid          Boolean           @default(false)
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business           Business            @relation(fields: [businessId], references: [id])
  createdBy          User                @relation("CreatedBy", fields: [createdById], references: [id])
  journalLines       JournalLine[]
  expenses           Expense[]
  debts              Debt[]
  debtorPayments     DebtorPayment[]
  payables           Payable[]
  creditorPayments   CreditorPayment[]
  saleItems          SaleItem[]
  stockPurchaseItems StockPurchaseItem[]
  sales              Sale[]

  @@index([businessId, entryDate])
  @@index([businessId, entryType])
  @@map("journal_entries")
}

model AuditLog {
  id              String   @id @default(uuid())
  businessId      String
  actorId         String?
  entity          String
  entityId        String
  action          String
  referenceNumber String?
  summary         String
  details         Json?
  createdAt       DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([businessId, entity, entityId])
  @@map("audit_logs")
}

// ─────────────── 5. journal_lines ───────────────

model JournalLine {
  id         String   @id @default(uuid())
  businessId String
  entryId    String
  accountId  String
  debit      Decimal  @default(0) @db.Decimal(15, 2)
  credit     Decimal  @default(0) @db.Decimal(15, 2)
  memo       String?
  createdAt  DateTime @default(now())

  business Business     @relation(fields: [businessId], references: [id])
  entry    JournalEntry @relation(fields: [entryId], references: [id])
  account  Account      @relation(fields: [accountId], references: [id])

  @@index([businessId])
  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Sale {
  id             String   @id @default(uuid())
  businessId     String
  journalEntryId String
  isCredit       Boolean  @default(false)
  totalRevenue   Decimal  @db.Decimal(10, 2)
  totalCogs      Decimal  @db.Decimal(10, 2)
  grossProfit    Decimal  @db.Decimal(10, 2)
  debtorId       String?
  createdById    String
  createdAt      DateTime @default(now())

  business     Business     @relation(fields: [businessId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  debtor       Debtor?      @relation(fields: [debtorId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  saleItems    SaleItem[]

  @@index([businessId, createdAt])
  @@index([journalEntryId])
  @@index([debtorId])
  @@map("sales")
}

model Expense {
  id               String        @id @default(uuid())
  businessId       String
  journalEntryId   String
  expenseAccountId String // the debited expense account (the category)
  amount           Decimal       @db.Decimal(10, 2)
  paymentMethod    PaymentMethod
  paidTo           String? // user-filled, structured, queryable
  notes            String? // user-filled, structured, queryable
  createdById      String
  createdAt        DateTime      @default(now())

  business       Business     @relation(fields: [businessId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  expenseAccount Account      @relation(fields: [expenseAccountId], references: [id])
  createdBy      User         @relation(fields: [createdById], references: [id])

  @@index([businessId, createdAt])
  @@index([journalEntryId])
  @@index([expenseAccountId])
  @@map("expenses")
}

// ─────────────── debtors (the PEOPLE who owe me) ───────────────

model Debtor {
  id         String   @id @default(uuid())
  businessId String
  name       String
  phone      String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id])
  debts    Debt[]
  sales    Sale[]
  payments DebtorPayment[]

  @@index([businessId, isActive])
  @@map("debtors")
}

// ─────────────── debts (individual debts owed TO you) ───────────────

model Debt {
  id                String     @id @default(uuid())
  businessId        String
  debtorId          String
  journalEntryId    String
  amountOriginal    Decimal    @db.Decimal(10, 2)
  amountOutstanding Decimal    @db.Decimal(10, 2)
  debtDate          DateTime   @db.Date
  dueDate           DateTime?  @db.Date
  status            DebtStatus @default(outstanding)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  business     Business     @relation(fields: [businessId], references: [id])
  debtor       Debtor       @relation(fields: [debtorId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])

  @@index([businessId, status])
  @@index([debtorId])
  @@map("debts")
}

// ─────────────── debtor_payments (payments received from a debtor) ───────────────

model DebtorPayment {
  id             String        @id @default(uuid())
  businessId     String
  debtorId       String
  journalEntryId String
  amountPaid     Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  paymentDate    DateTime      @db.Date
  receivedById   String
  notes          String?
  createdAt      DateTime      @default(now())

  business     Business     @relation(fields: [businessId], references: [id])
  debtor       Debtor       @relation(fields: [debtorId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  receivedBy   User         @relation(fields: [receivedById], references: [id])

  @@index([businessId])
  @@index([debtorId])
  @@map("debtor_payments")
}

// ─────────────── creditors (the SUPPLIERS i owe) ───────────────

model Creditor {
  id         String   @id @default(uuid())
  businessId String
  name       String
  phone      String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id])
  payables Payable[]
  payments CreditorPayment[]

  @@index([businessId, isActive])
  @@map("creditors")
}

// ─────────────── payables (individual amounts YOU owe) ───────────────

model Payable {
  id                String     @id @default(uuid())
  businessId        String
  creditorId        String
  journalEntryId    String
  amountOriginal    Decimal    @db.Decimal(10, 2)
  amountOutstanding Decimal    @db.Decimal(10, 2)
  debtDate          DateTime   @db.Date
  dueDate           DateTime?  @db.Date
  status            DebtStatus @default(outstanding)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  business     Business     @relation(fields: [businessId], references: [id])
  creditor     Creditor     @relation(fields: [creditorId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])

  @@index([businessId, status])
  @@index([creditorId])
  @@map("payables")
}

// ─────────────── creditor_payments (payments made to a supplier) ───────────────

model CreditorPayment {
  id             String        @id @default(uuid())
  businessId     String
  creditorId     String
  journalEntryId String
  amountPaid     Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  paymentDate    DateTime      @db.Date
  paidById       String
  notes          String?
  createdAt      DateTime      @default(now())

  business     Business     @relation(fields: [businessId], references: [id])
  creditor     Creditor     @relation(fields: [creditorId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  paidBy       User         @relation(fields: [paidById], references: [id])

  @@index([businessId])
  @@index([creditorId])
  @@map("creditor_payments")
}

// ─────────────── 10. products ───────────────

model Product {
  id               String   @id @default(uuid())
  businessId       String
  categoryId       String?
  name             String
  sku              String?
  barcode          String?
  sellingPrice     Decimal  @db.Decimal(10, 2)
  costPrice        Decimal  @db.Decimal(10, 2) // weighted average — drives COGS/profit/valuation
  lastPurchaseCost Decimal? @db.Decimal(10, 2) // most recent purchase cost — display only, for pricing decisions
  currentStockQty  Decimal  @default(0) @db.Decimal(10, 3)
  minimumStockQty  Decimal  @default(0) @db.Decimal(10, 3)
  unitOfMeasure    String   @default("piece")
  isActive         Boolean  @default(true)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business           Business            @relation(fields: [businessId], references: [id])
  category           ProductCategory?    @relation(fields: [categoryId], references: [id])
  createdBy          User                @relation(fields: [createdById], references: [id])
  saleItems          SaleItem[]
  stockPurchaseItems StockPurchaseItem[]

  @@unique([businessId, sku])
  @@index([businessId, isActive])
  @@map("products")
}

// ─────────────── 11. product_categories ───────────────

model ProductCategory {
  id         String   @id @default(uuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id])
  products Product[]

  @@index([businessId])
  @@map("product_categories")
}

// ─────────────── 12. sale_items ───────────────

model SaleItem {
  id               String   @id @default(uuid())
  businessId       String
  saleId           String
  journalEntryId   String
  productId        String?
  productName      String
  unitSellingPrice Decimal  @db.Decimal(10, 2)
  unitCostPrice    Decimal  @db.Decimal(10, 2)
  quantity         Decimal  @db.Decimal(10, 3)
  lineTotal        Decimal  @db.Decimal(10, 2)
  lineCogs         Decimal  @db.Decimal(10, 2)
  lineGrossProfit  Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  business     Business     @relation(fields: [businessId], references: [id])
  sale         Sale         @relation(fields: [saleId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])

  @@index([businessId])
  @@index([saleId])
  @@index([journalEntryId])
  @@index([productId])
  @@map("sale_items")
}

// ─────────────── 13. stock_purchase_items ───────────────

model StockPurchaseItem {
  id             String   @id @default(uuid())
  businessId     String
  journalEntryId String
  productId      String?
  productName    String
  quantity       Decimal? @db.Decimal(10, 3)
  unitCost       Decimal  @db.Decimal(10, 2)
  lineTotal      Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  business     Business     @relation(fields: [businessId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])

  @@index([businessId])
  @@index([journalEntryId])
  @@map("stock_purchase_items")
}

// ─────────────── 14. stock_counts ───────────────

model StockCount {
  id              String          @id @default(uuid())
  businessId      String
  countDate       DateTime        @db.Date
  stockValue      Decimal         @db.Decimal(10, 2)
  countType       StockCountType
  confidenceLevel ConfidenceLevel
  notes           String?
  recordedById    String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  business   Business @relation(fields: [businessId], references: [id])
  recordedBy User     @relation(fields: [recordedById], references: [id])

  @@index([businessId, countDate])
  @@map("stock_counts")
}

// ─────────────── 15. assets ───────────────

model Asset {
  id            String          @id @default(uuid())
  businessId    String
  assetName     String
  assetType     AssetType
  currentValue  Decimal         @db.Decimal(10, 2)
  purchaseValue Decimal?        @db.Decimal(10, 2)
  purchaseDate  DateTime?       @db.Date
  condition     AssetCondition?
  notes         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, isActive])
  @@map("assets")
}

// ─────────────── 16. sync_queue ───────────────

model SyncQueue {
  id               String     @id
  businessId       String
  userId           String
  operation        String
  payload          Json
  deviceId         String
  createdLocallyAt DateTime
  syncedAt         DateTime?
  syncStatus       SyncStatus @default(pending)
  retryCount       Int        @default(0)
  errorMessage     String?
  createdAt        DateTime   @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([businessId, syncStatus])
  @@map("sync_queue")
}

// ─────────────── 17. notifications ───────────────

model Notification {
  id         String           @id @default(uuid())
  businessId String
  type       NotificationType
  title      String
  message    String
  relatedId  String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, isRead])
  @@map("notifications")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  deviceInfo String?
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

enum ConversationMessageRole {
  user
  assistant
  system
  tool
}

model Conversation {
  id         String   @id @default(cuid())
  userId     String
  businessId String?
  title      String?
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])

  messages  ConversationMessage[]
  summary   ConversationSummary?
  state     ConversationState?

  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@map("conversations")
}

model ConversationMessage {
  id             String                  @id @default(cuid())
  conversationId String
  role           ConversationMessageRole
  content        String
  createdAt      DateTime                @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model ConversationSummary {
  id             String   @id @default(cuid())
  conversationId String   @unique
  summary        String
  topics         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_summaries")
}

model ConversationState {
  id             String   @id @default(cuid())
  conversationId String   @unique
  currentTopic   String?
  currentIntent  String?
  state          Json
  lastToolUsed   String?
  lastToolResult Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_states")
}
